{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sal.round/1",
  "title": "A review round: the question and the takes it compares",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "created",
    "project",
    "question",
    "blind",
    "views",
    "takes"
  ],
  "properties": {
    "schema": {
      "const": "sal.round/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "blind": {
      "type": "boolean"
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "takes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "path",
          "duration",
          "label",
          "control"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "pattern": "^media/[0-9a-f]{64}\\.[A-Za-z0-9]+$"
          },
          "source": {
            "type": "string",
            "pattern": "^/"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "control": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
