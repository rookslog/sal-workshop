{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sal.comment/1",
  "title": "One comment on a stretch of one take, never edited after it is written",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "created",
    "round",
    "take",
    "span",
    "kind",
    "text",
    "author",
    "channel",
    "answers",
    "replaces"
  ],
  "properties": {
    "schema": {
      "const": "sal.comment/1"
    },
    "id": {
      "type": "string",
      "pattern": "^c-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$"
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "round": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "take": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "label_shown"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "label_shown": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "kind": {
      "enum": [
        "flag",
        "question",
        "request",
        "verdict",
        "answer"
      ]
    },
    "text": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "pattern": "^(operator|agent:[a-z0-9-]+/[a-z0-9.-]+)$"
    },
    "channel": {
      "enum": [
        "page",
        "chat-transcribed",
        "agent"
      ]
    },
    "answers": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^c-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "replaces": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^c-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
